{
  "mcpServers": {
    "research": {
      "command": "./starter/.venv/bin/python",
      "args": ["-m", "mcp_research", "server"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}
